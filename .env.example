# Database connection string (PostgreSQL with psycopg3 driver)
DATABASE_URL=postgresql+psycopg://flowops:flowops@localhost:5432/flowops

# Classification provider: "local" (deterministic rule-based) or "llm" (external LLM)
CLASSIFICATION_PROVIDER=local

# Optional external LLM configuration (only used if CLASSIFICATION_PROVIDER=llm)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional n8n or generic webhook URL for request creation and status update events
N8N_WEBHOOK_URL=

# Express proxy backend target (if using workspace preview)
FASTAPI_URL=http://127.0.0.1:8000
